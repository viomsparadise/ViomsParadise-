# Supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Razorpay (public key only — never put the secret key in frontend env vars)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Business contact (used by the Contact page + floating buttons)
VITE_WHATSAPP_NUMBER=919999999999
VITE_PHONE_NUMBER=+919999999999

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY — set these via Supabase Edge Function secrets:
#   supabase secrets set KEY=value
# NEVER put these in your .env file or commit them to git.
# ─────────────────────────────────────────────────────────────────────────────

# Razorpay server-side keys (used by create-razorpay-order + verify-razorpay-payment)
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# MSG91 — OTP + Booking SMS (used by send-sms-hook)
# Get these from https://control.msg91.com
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_SENDER_ID=VIOMSP               # 6-char DLT sender ID registered for your business
# MSG91_OTP_TEMPLATE_ID=               # Template ID for OTP SMS (MSG91 Flow ID)
# MSG91_BOOKING_TEMPLATE_ID=           # Template ID for booking confirmation SMS
# MSG91_ADMIN_TEMPLATE_ID=             # Template ID for admin notification SMS
# MSG91_ADMIN_PHONE=919876543210       # Admin phone in E.164 digits (no +), e.g. 919876543210

# Email notifications (used by notify-admin-email)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# ADMIN_NOTIFICATION_EMAIL=owner@example.com

# ─────────────────────────────────────────────────────────────────────────────
# MSG91 DLT Template Examples
# Register these templates on https://smartping.live (DLT portal) before use.
#
# OTP Template:
#   "Your OTP for Viom's Paradise is {{otp}}. Valid for 10 minutes. Do not share."
#
# Booking Confirmation Template (variables: GuestName, CheckIn, CheckOut, Guests, BookingRef):
#   "Hi {{GuestName}}, your booking at Viom's Paradise is confirmed.
#    Check-in: {{CheckIn}} | Check-out: {{CheckOut}} | Guests: {{Guests}}
#    Ref: {{BookingRef}}. Thank you for choosing Viom's Paradise."
#
# Admin Notification Template (variables: GuestName, GuestPhone, CheckIn, CheckOut,
#   Guests, BookingID, BookingRef, Amount):
#   "New booking! Guest: {{GuestName}} ({{GuestPhone}}) | Check-in: {{CheckIn}}
#    Check-out: {{CheckOut}} | Guests: {{Guests}} | Ref: {{BookingRef}} | Amt: Rs{{Amount}}"
# ─────────────────────────────────────────────────────────────────────────────
